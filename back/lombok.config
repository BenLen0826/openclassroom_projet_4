# Fichier de configuration de Lombok pour ce projet.
# Ne pas chercher d'autre lombok.config dans les dossiers parents.
config.stopBubbling = true
# Ajoute l'annotation @Generated au code produit par Lombok (getters, setters, equals, hashCode...).
# JaCoCo ignore ce code dans le rapport de couverture : seul le code écrit à la main est mesuré.
lombok.addLombokGeneratedAnnotation = true
